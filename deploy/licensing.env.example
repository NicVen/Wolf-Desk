# STAALWAG licensing — copy to /etc/staalwag-licensing.env, fill in, chmod 600.
# Secrets NEVER go in git.

BIND_ADDR=127.0.0.1
PORT=8790
DB_PATH=/var/lib/staalwag-licensing/licenses.db
PUBLIC_BASE_URL=https://pay.178.104.88.38.sslip.io

# --- NOWPayments (crypto — from your dashboard) ---
NOWPAYMENTS_API_KEY=paste-your-api-key
NOWPAYMENTS_IPN_SECRET=paste-your-ipn-secret

# --- Stripe (cards — leave blank until you sign up; card button stays hidden) ---
# 1. stripe.com -> Developers -> API keys -> Secret key (sk_live_... / sk_test_...)
# 2. Developers -> Webhooks -> add endpoint https://pay.178.104.88.38.sslip.io/card_ipn
#    event checkout.session.completed -> copy its signing secret (whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- signing / admin (generate random strings) ---
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
LICENSE_SIGNING_SECRET=generate-a-random-string
ADMIN_TOKEN=generate-a-random-string

# --- behaviour ---
GRACE_HOURS=4
RENEW_NOTICE_DAYS=3
TOKEN_TTL_HOURS=6

# --- Trader Quiz: winner is auto-announced on the 1st of each month ---
QUIZ_AUTO_WINNER=1
# Rewards ROTATE each month from licensing/quiz_rewards.json (edit that list).
# Optional override: a pipe-separated pool here, or a single fallback below.
# QUIZ_REWARDS=1 month free VIP|A free EA for a month|A free indicator for a month
QUIZ_REWARD=1 month free VIP

# --- optional: Telegram notices to clients (numeric chat id) + you ---
LICENSE_BOT_TOKEN=
LICENSE_ADMIN_CHAT=

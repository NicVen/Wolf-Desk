# WOLF Desk server environment. Copy to /etc/wolf-desk.env and edit.
# This file holds your secret key — keep it OUT of git (it is not committed).

# The ONLY lock on your public app — make it long and random.
WOLF_PASS=CHANGE-ME-to-a-long-random-key

# Behind Caddy: keep the app private on localhost (Caddy faces the internet).
BIND_ADDR=127.0.0.1
PORT=8777

# Live-price refresh cadence (minutes).
REFRESH_MIN=20

# Where the Markov gate files + markov_regime.json are written on the server
# (served to your PC at /markov.json for the MT5 bridge).
MARKOV_OUT_DIR=/opt/wolf-desk/markov_out

# Optional Telegram VIP login (leave blank if you don't use it).
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=
VIP_CHANNELS=

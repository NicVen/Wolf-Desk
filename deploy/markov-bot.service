[Unit]
Description=Markov 18-pair signal bot (one call per idea, results posted)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wolf
WorkingDirectory=/opt/wolf-desk/markov
EnvironmentFile=/etc/markov-bot.env
ExecStart=/usr/bin/env node server.js
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
